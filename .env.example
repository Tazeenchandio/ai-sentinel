# Database (PostgreSQL default or SQLite for local dev/testing)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aisentinel?schema=public"

# Anthropic AI Key & Configurable Models
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
AI_TRIAGE_MODEL="claude-3-5-haiku-20241022"
AI_ANALYSIS_MODEL="claude-3-5-sonnet-20241022"
AI_DEEP_ANALYSIS_MODEL="claude-3-5-sonnet-20241022"

# Security & Session Authentication
JWT_SECRET="super-secret-sentinel-jwt-token-key-2030"
NEXTAUTH_SECRET="sentinel-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Optional GitHub Integration
GITHUB_PAT=""

# App Settings
NODE_ENV="development"
NEXT_PUBLIC_DEMO_MODE="true"
